{
  "name": "agent-evals",
  "version": "0.1.0",
  "description": "Evaluation harness for LLM agents with an immutable baseline enforced as a CI gate.",
  "license": "MIT",
  "author": "Filip Stojanovi\u0107",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "calibrate": "tsx src/calibrate.ts",
    "eval": "tsx src/cli.ts",
    "eval:fixture": "tsx src/cli.ts --fixture",
    "judge:variance": "tsx src/judge-variance.ts",
    "calibrate:semantic": "tsx src/calibrate-semantic.ts",
    "readme:refresh": "tsx src/readme-refresh.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@huggingface/transformers": "^4.2.0",
    "ajv": "^8.20.0",
    "dotenv": "^17.4.2",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
